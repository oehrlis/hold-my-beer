# Kopie als .env ablegen. Werte aus der Shell (z.B. PORT=8080 ./start.sh) haben Vorrang.
APP_ENV=development            # development | testing | production
# SECRET_KEY=...               # Pflicht in production: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# ADMIN_PASSWORD=...           # Pflicht in production. Development-Standard: oracle-dev
# PUBLIC_BASE_URL=https://voting.example.org   # Ziel des QR-Codes; leer = automatisch erkannte lokale IP
# SHARE_URL=https://voting.example.org         # Ziel des Teilen-QR-Codes (Icon); leer = PUBLIC_BASE_URL
# POOL_FILE=../pool/doag-ak-2026.yaml          # Themenpool (YAML); relativ = ab App-Verzeichnis
# DATABASE_URL=sqlite:////absoluter/pfad/voting.db   # Standard: instance/voting.db
HOST=0.0.0.0
PORT=5000
PROXY_FIX_ENABLED=false        # true nur hinter eigenem Reverse Proxy / Cloudflare (nur production)
# PROXY_FIX_X_FOR=1            # Proxies, die X-Forwarded-For anhaengen: Cloudflare Tunnel 1, Cloudflare + Nginx 2
# SESSION_COOKIE_SECURE=false  # nur fuer den HTTP-Test ohne HTTPS; in production sonst true
# BACKUP_DIR=/pfad/zu/backups
# APP_THEME=acn                # Layout-Vorgabe: acn (Accenture) | hmb (Hold my Beer); der Admin kann sie aendern
