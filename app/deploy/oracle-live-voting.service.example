# Beispiel; deploy-public.sh erzeugt diese Unit automatisch.
[Unit]
Description=Oracle Live Voting (Gunicorn, 1 Worker / 8 Threads)
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/opt/oracle-live-voting/current
EnvironmentFile=/opt/oracle-live-voting/shared/app.env
ExecStart=/opt/oracle-live-voting/venv/bin/gunicorn -c gunicorn.conf.py wsgi:app
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=35
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/opt/oracle-live-voting/shared

[Install]
WantedBy=multi-user.target
